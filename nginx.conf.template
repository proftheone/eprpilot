server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/html text/css application/javascript image/svg+xml;

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    location /img/ {
        expires 30d;
        add_header Cache-Control "public";
    }

    error_page 404 /index.html;
}
